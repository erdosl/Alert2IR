OBSERVABILITY_DATA_ROOT=/srv/alert2ir-observability
GRAFANA_ADMIN_USER=admin

# Keep both files outside the repository with restrictive ownership and mode.
GRAFANA_ADMIN_PASSWORD_FILE=/etc/alert2ir-observability/secrets/grafana_admin_password
GRAFANA_SECRET_KEY_FILE=/etc/alert2ir-observability/secrets/grafana_secret_key
