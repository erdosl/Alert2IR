{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alert2ir:detection-validation:v2",
  "title": "Alert2IR sanitized detection validation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "validation_id",
    "positive_scenario_id",
    "objective",
    "toolchain",
    "ground_truth",
    "searches",
    "matches",
    "control_results",
    "result_state"
  ],
  "properties": {
    "schema": {
      "const": "alert2ir-detection-validation-v2"
    },
    "validation_id": {
      "type": "string",
      "format": "uuid"
    },
    "positive_scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_expectation_id",
        "rule_path",
        "rule_id",
        "pipeline_path",
        "content_class"
      ],
      "properties": {
        "primary_expectation_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_path": {
          "type": "string",
          "pattern": "^detections/sigma/.+\\.ya?ml$"
        },
        "rule_id": {
          "type": "string",
          "format": "uuid"
        },
        "pipeline_path": {
          "type": "string",
          "pattern": "^config/sigma/pipelines/.+\\.ya?ml$"
        },
        "content_class": {
          "enum": [
            "production_intent",
            "validation_only"
          ]
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sigma_cli",
        "pysigma",
        "pysigma_backend_splunk"
      ],
      "properties": {
        "sigma_cli": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "pysigma": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "pysigma_backend_splunk": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_events"
      ],
      "properties": {
        "expected_events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "expectation_id",
              "event_ref",
              "role",
              "phase",
              "timestamp_utc"
            ],
            "properties": {
              "expectation_id": {
                "type": "string",
                "minLength": 1
              },
              "event_ref": {
                "$ref": "#/$defs/eventRef"
              },
              "role": {
                "enum": [
                  "primary",
                  "secondary",
                  "cleanup",
                  "related"
                ]
              },
              "phase": {
                "enum": [
                  "execution",
                  "investigation_window",
                  "cleanup"
                ]
              },
              "timestamp_utc": {
                "$ref": "#/$defs/utcTimestamp"
              }
            }
          }
        }
      }
    },
    "searches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "search_id",
          "logsource",
          "event_code",
          "validation_window",
          "environment_scope",
          "referenced_event_refs",
          "generated_spl",
          "executed_spl",
          "hashes",
          "result_count",
          "search_executed_at_utc"
        ],
        "properties": {
          "search_id": {
            "type": "string",
            "pattern": "^search-[a-z0-9-]+$"
          },
          "logsource": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "product",
              "category"
            ],
            "properties": {
              "product": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "event_code": {
            "type": "integer"
          },
          "validation_window": {
            "$ref": "#/$defs/timeWindow"
          },
          "environment_scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope_ref",
              "summary"
            ],
            "properties": {
              "scope_ref": {
                "type": "string",
                "pattern": "^scope-[a-z0-9-]+$"
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "referenced_event_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/eventRef"
            }
          },
          "generated_spl": {
            "type": "string",
            "minLength": 1
          },
          "executed_spl": {
            "type": "string",
            "minLength": 1
          },
          "hashes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_sha256",
              "pipeline_sha256",
              "generated_spl_sha256",
              "executed_spl_sha256"
            ],
            "properties": {
              "rule_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "pipeline_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "generated_spl_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "executed_spl_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "result_count": {
            "type": "integer",
            "minimum": 0
          },
          "search_executed_at_utc": {
            "$ref": "#/$defs/utcTimestamp"
          }
        }
      }
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "match_ref",
          "search_id",
          "event_ref",
          "classification",
          "attributable",
          "event_code",
          "timestamp_utc"
        ],
        "properties": {
          "match_ref": {
            "type": "string",
            "pattern": "^match-[a-z0-9-]+$"
          },
          "search_id": {
            "type": "string",
            "pattern": "^search-[a-z0-9-]+$"
          },
          "event_ref": {
            "anyOf": [
              {
                "$ref": "#/$defs/eventRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "classification": {
            "enum": [
              "expected_primary",
              "expected_secondary",
              "related_wrapper",
              "unexpected_related",
              "environmental_noise",
              "false_positive"
            ]
          },
          "attributable": {
            "type": "boolean"
          },
          "event_code": {
            "type": "integer"
          },
          "timestamp_utc": {
            "$ref": "#/$defs/utcTimestamp"
          }
        }
      }
    },
    "control_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_variant_id",
          "control_run_id",
          "search_id",
          "expected_attributable_count",
          "attributable_count",
          "match_refs",
          "result"
        ],
        "properties": {
          "control_variant_id": {
            "type": "string",
            "minLength": 1
          },
          "control_run_id": {
            "type": "string",
            "format": "uuid"
          },
          "search_id": {
            "type": "string",
            "pattern": "^search-[a-z0-9-]+$"
          },
          "expected_attributable_count": {
            "const": 0
          },
          "attributable_count": {
            "type": "integer",
            "minimum": 0
          },
          "match_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^match-[a-z0-9-]+$"
            }
          },
          "result": {
            "enum": [
              "pass",
              "fail_control_matched",
              "review_unexpected_match",
              "blocked_telemetry"
            ]
          }
        }
      }
    },
    "result_state": {
      "enum": [
        "pass",
        "pass_with_related",
        "fail_missing_primary",
        "fail_control_matched",
        "review_unexpected_match",
        "blocked_telemetry"
      ]
    }
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_utc",
        "end_utc"
      ],
      "properties": {
        "start_utc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "end_utc": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    },
    "eventRef": {
      "type": "string",
      "pattern": "^event-[a-z0-9-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
