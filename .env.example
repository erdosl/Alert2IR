POSTGRES_DB=alert2ir
POSTGRES_USER=alert2ir
POSTGRES_PASSWORD=<replace-me>
ALERT2IR_DATABASE_URL=postgresql://alert2ir:<url-encoded-replace-me>@postgres:5432/alert2ir
ALERT2IR_BACKEND=mock

# Required only when adding compose.velociraptor.yaml. Keep the API configuration
# external to the repository and provide its absolute protected host path here.
# ALERT2IR_VELOCIRAPTOR_API_CONFIG_SOURCE=/absolute/path/to/protected-api-config.yaml
# ALERT2IR_VELOCIRAPTOR_HOST=<replace-me>
# ALERT2IR_VELOCIRAPTOR_CLIENT_ID=<replace-me>
